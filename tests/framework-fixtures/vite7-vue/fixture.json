{
  "name": "Vite 7 + Vue 3 SFC",
  "config": {
    "files": [
      "index.html"
    ],
    "insertBefore": "</body>",
    "commentSyntax": "html"
  },
  "sourceFiles": [
    "index.html",
    "src/App.vue",
    "src/main.js",
    "vite.config.js"
  ],
  "generatedFiles": [],
  "wrapCases": [
    {
      "name": "wraps the note form in App.vue",
      "args": {
        "classes": "note-form",
        "tag": "form"
      },
      "expectedFile": "src/App.vue"
    }
  ],
  "runtime": {
    "styling": "plain-css",
    "install": [
      "npm",
      "install",
      "--no-audit",
      "--no-fund",
      "--loglevel=error"
    ],
    "devCommand": [
      "npx",
      "vite",
      "--host",
      "127.0.0.1"
    ],
    "readyPattern": "Local:\\s+https?://[^:]+:(\\d+)",
    "readyTimeoutMs": 120000,
    "pickSelector": "form.note-form",
    "pickPosition": {
      "x": 6,
      "y": 6
    },
    "variantSequence": [
      3,
      1,
      2
    ],
    "acceptedSourcePattern": "<form[^>]*class=\"note-form\"",
    "assertSourceContains": [
      "const note = ref('');",
      "<main class=\"page\">"
    ],
    "steer": false,
    "probe": {
      "expectLiveInit": true,
      "expectConsoleClean": true
    }
  }
}
