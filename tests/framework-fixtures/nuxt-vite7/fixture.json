{
  "name": "Nuxt 4 + Vue 3",
  "config": {
    "files": ["app.vue"],
    "insertBefore": "</body>",
    "commentSyntax": "html"
  },
  "sourceFiles": ["app.vue", "pages/index.vue", "nuxt.config.ts"],
  "generatedFiles": [],
  "wrapCases": [
    {
      "name": "wraps hero in pages/index.vue",
      "args": { "classes": "hero-title", "tag": "h1" },
      "expectedFile": "pages/index.vue"
    }
  ],
  "runtime": {
    "styling": "plain-css",
    "install": ["npm", "install", "--no-audit", "--no-fund", "--loglevel=error"],
    "devCommand": ["npx", "nuxt", "dev", "--host", "127.0.0.1"],
    "readyPattern": "Local:\\s+https?://[^:]+:(\\d+)",
    "readyTimeoutMs": 120000,
    "waitForHttpOk": true,
    "pickSelector": "h1.hero-title",
    "variantSequence": [3, 1, 2],
    "acceptedSourcePattern": "<h1[^>]*class=\"hero-title\"",
    "assertSourceContains": [
      "<main class=\"page\">",
      "Nuxt + Vite 7 Fixture",
      "<p class=\"hero-hook\">"
    ],
    "steer": {
      "sourceFile": "pages/index.vue"
    },
    "probe": {
      "expectLiveInit": true,
      "expectConsoleClean": true
    }
  }
}
