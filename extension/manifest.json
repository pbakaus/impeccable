{
  "manifest_version": 3,
  "name": "Impeccable",
  "description": "Find design and usability problems on any web page: scan it for AI slop and anti-patterns, or send an AI persona to try a task.",
  "version": "1.5.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "offscreen",
    "debugger",
    "tabs",
    "tabGroups",
    "sidePanel",
    "downloads",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/chrome-worker.js",
    "type": "module"
  },
  "devtools_page": "devtools/devtools.html",
  "options_ui": {
    "page": "popup/settings.html",
    "open_in_tab": false
  },
  "side_panel": {
    "default_path": "walks/panel/panel.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://impeccable.reviews/app/*/outings/*",
        "https://app.impeccable.style/app/*/outings/*",
        "http://localhost/app/*/outings/*",
        "http://app.localhost/app/*/outings/*"
      ],
      "js": [
        "walks/handoff-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://impeccable.reviews/app/*/outings/*",
        "https://app.impeccable.style/app/*/outings/*",
        "http://localhost/app/*/outings/*",
        "http://app.localhost/app/*/outings/*",
        "https://impeccable.reviews/app/cli/authorize*",
        "https://app.impeccable.style/app/cli/authorize*",
        "http://localhost/app/cli/authorize*",
        "http://app.localhost/app/cli/authorize*"
      ],
      "js": [
        "walks/present.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://impeccable.reviews/pro/welcome*",
        "http://localhost/pro/welcome*"
      ],
      "js": [
        "account/welcome.js"
      ],
      "run_at": "document_start"
    }
  ]
}
